{
  "name": "pmcpg-website",
  "version": "0.1.0",
  "private": true,
  "description": "pmcpg.io: the promo site for Private MCP Gateway. Static export; never part of the gateway binary.",
  "scripts": {
    "dev": "bun scripts/copy-assets.ts && next dev --port 3100",
    "prebuild": "NODE_PATH=./node_modules bun --no-install scripts/check-catalog.ts",
    "build": "bun scripts/copy-assets.ts && next build",
    "typecheck": "tsc --noEmit",
    "catalog:build": "NODE_PATH=./node_modules bun --no-install scripts/build-catalog.ts",
    "catalog:import": "NODE_PATH=./node_modules bun --no-install scripts/catalog-import.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.77.0",
    "motion": "14.14.0",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "marked": "18.2.1",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": "24.x"
  }
}
